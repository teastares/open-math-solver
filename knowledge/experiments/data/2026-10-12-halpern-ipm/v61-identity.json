  "archiver_source": "\"\"\"保存本轮独立程序、来源、捕获及核验证据，逐项回读归档。\"\"\"\nimport datetime\nimport hashlib\nimport json\nfrom pathlib import Path\nimport zipfile\n\nROOT = Path(__file__).resolve().parents[1]\nDATA = ROOT / 'knowledge/experiments/data/2026-10-12-halpern-ipm'\nWORK = ROOT / '.tools/v61-diagnostic'\ndestination = DATA / 'v61-artifacts.zip'\nidentity_path = DATA / 'v61-identity.json'\nassert not destination.exists() and not identity_path.exists()\nverification = json.loads((DATA / 'v61-verification.json').read_text(encoding='utf-8'))\nassert verification['passed']\n\ndef sha(data):\n    return hashlib.sha256(data).hexdigest()\n\nfiles = {p for p in WORK.rglob('*') if p.is_file() and '__pycache__' not in p.parts}\nfiles.update(p for p in DATA.glob('v61-*') if p.is_file() and p not in (destination, identity_path))\nfiles.update(DATA / name for name in ('ipm-v60-identity.json', 'ipm-v60-source.zip',\n    'v60-restored-state.json', 'v60-restored-ctest-attempt2.json', 'v60-verification.json',\n    'v47-profile-build.py', 'v53-analyze-hsd.py'))\nfiles.update((ROOT / '.tools/solver-ipm-v60.exe', Path(__file__), ROOT / '.tools/v61-verify-inline.py'))\nplan = json.loads((DATA / 'v61-plan.json').read_text(encoding='utf-8'))\nfiles.update(Path(model['input']) for model in plan['models'])\nfiles.update(ROOT / '.deps/highs-source/highs/ipm/ipx' / name for name in\n    ('lp_solver.cc', 'kkt_solver_basis.cc', 'splitted_normal_matrix.cc', 'maxvolume.cc', 'basis.cc', 'ipm.cc', 'conjugate_residuals.cc'))\nassert all(p.resolve().is_relative_to(ROOT) and p.is_file() for p in files)\nentries = {}\nwith zipfile.ZipFile(destination, 'x', zipfile.ZIP_DEFLATED, compresslevel=6) as archive:\n    for p in sorted(files):\n        content = p.read_bytes()\n        name = p.relative_to(ROOT).as_posix()\n        entries[name] = {'sha256': sha(content), 'bytes': len(content)}\n        archive.writestr(name, content)\nwith zipfile.ZipFile(destination) as archive:\n    assert set(archive.namelist()) == set(entries) and len(archive.namelist()) == len(entries)\n    for name, expected in entries.items():\n        content = archive.read(name)\n        assert {'sha256': sha(content), 'bytes': len(content)} == expected\n        assert sha((ROOT / name).read_bytes()) == expected['sha256']\nresult = {'schema': 'v61_artifacts_1', 'diagnostic_only': True, 'created_at_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),\n    'archive_path': str(destination), 'archive_sha256': sha(destination.read_bytes()), 'archive_bytes': destination.stat().st_size,\n    'entry_count': len(entries), 'entries': entries, 'archive_readback_verified': True,\n    'verification_sha256': sha((DATA / 'v61-verification.json').read_bytes()),\n    'archiver_source': Path(__file__).read_text(encoding='utf-8'),\n    'limits': ['保存实际两个LP程序、诊断自测程序、冻结来源和捕获；没有复制完整工具链及第三方库。',\n        '归档自身及此身份记录不属于归档成员。', '本操作不执行LP或重新运行精确数值分析。'], 'lp_runs': 0}\nwith identity_path.open('x', encoding='utf-8') as target:\n    json.dump(result, target, ensure_ascii=False, indent=2)\n    target.write('\\n')\nprint(json.dumps({k: result[k] for k in ('archive_sha256', 'archive_bytes', 'entry_count', 'archive_readback_verified')}, ensure_ascii=False))\n",
