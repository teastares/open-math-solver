  "source_sha256": {
    "D:\\Documents\\codes\\solver\\knowledge\\experiments\\data\\2026-10-12-halpern-ipm\\v82-plan.json": "b5df77438c3905566b0a8ddb02b84c2c2f65484facfe26bf559ec2ae085ec44b",
    "D:\\Documents\\codes\\solver\\knowledge\\experiments\\data\\2026-10-12-halpern-ipm\\v82-run-manifest.json": "072d6e1fdf1bb5b8e5f05e7ac0b3c48da955f9c4978f510e1a2e5e5748325bde",
    "D:\\Documents\\codes\\solver\\knowledge\\experiments\\data\\2026-10-12-halpern-ipm\\v82-runs.jsonl.gz": "8d7123642c956821ec96f2fac7e91a134d0b9ff3d704f8f75b35088096f6ae4b",
    "D:\\Documents\\codes\\solver\\knowledge\\experiments\\data\\2026-10-12-halpern-ipm\\v82-summary.json": "727808db15b00569e566ea82b91bb0c83f282d60aed8d9955ab297e0d6789fd6"
  },
  "driver_source": "\"\"\"汇总当前85条诊断的实际计时；逐条守恒与阶段中位数分开解释。\"\"\"\nimport collections\nimport datetime\nimport gzip\nimport hashlib\nimport json\nfrom pathlib import Path\nimport sys\n\nROOT = Path(__file__).resolve().parents[1]\nDATA = ROOT / 'knowledge/experiments/data/2026-10-12-halpern-ipm'\nOUTPUT = DATA / 'v82-cost-analysis.json'\nsys.dont_write_bytecode = True\nsys.path.insert(0, str(ROOT / 'scripts'))\nimport benchmark\n\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef read(path):\n    return benchmark.strict_json(Path(path).read_text(encoding='utf-8'))\n\n\nassert not OUTPUT.exists()\nplan = read(DATA / 'v82-plan.json')\nassert sha(DATA / 'v82-plan.json') == 'b5df77438c3905566b0a8ddb02b84c2c2f65484facfe26bf559ec2ae085ec44b'\nrows = [benchmark.strict_json(line) for line in gzip.decompress((DATA / 'v82-runs.jsonl.gz').read_bytes()).splitlines()]\nsummary = read(DATA / 'v82-summary.json')\nassert len(rows) == plan['runs'] == 85 and summary['non_budget_equal'] == summary['non_budget_pairs'] == 68\nassert summary['budget_pairs'] == summary['invalid_pairs'] == summary['different_pairs'] == summary['profile_errors'] == 0\non = [row for row in rows if row['variant'].startswith('on')]\nassert len(on) == 51\nfor row in on:\n    p = row['profile']\n    assert row['profile_error'] is None and list(p['stages']) == plan['profile_stages']\n    assert sum(s['exclusive_ns'] for s in p['stages'].values()) == p['total_inclusive_ns']\naggregates = {}\nfor name, selected in (('all_on', on), ('quality_pass_on', [row for row in on if row['quality_pass']])):\n    exclusive, inclusive, calls = collections.Counter(), collections.Counter(), collections.Counter()\n    total = sum(row['profile']['total_inclusive_ns'] for row in selected)\n    for row in selected:\n        stages = row['profile']['stages']\n        exclusive.update({key: value['exclusive_ns'] for key, value in stages.items()})\n        inclusive.update({key: value['inclusive_ns'] for key, value in stages.items()})\n        calls.update({key: value['started'] for key, value in stages.items()})\n    assert sum(exclusive.values()) == total\n    aggregates[name] = {'profiles': len(selected), 'total_inclusive_ns': total,\n        'exclusive_sum_ns': sum(exclusive.values()), 'conserved': True,\n        'stages_by_exclusive': [{'stage': key, 'exclusive_ns': value,\n            'exclusive_fraction': value / total, 'inclusive_ns': inclusive[key], 'started': calls[key]}\n            for key, value in exclusive.most_common()]}\ncases = []\nfor case in summary['cases']:\n    medians = case['stage_medians']\n    assert medians is not None\n    cases.append({'model': case['model'], 'case_index': case['case_index'],\n        'median_total_ns': medians['total']['inclusive_ns'],\n        'top_exclusive_medians': [{'stage': key, **medians[key]} for key in sorted(medians,\n            key=lambda key: medians[key]['exclusive_ns'], reverse=True)[:5]],\n        'status': case['status'], 'numerical_seconds': case['numerical_seconds']})\nsources = [DATA / ('v82-' + name) for name in ('plan.json', 'run-manifest.json', 'runs.jsonl.gz', 'summary.json')]\nresult = {'passed': True, 'created_at_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),\n    'new_solver_runs': 0, 'actual_profile_runs': 85, 'actual_on_profiles': 51,\n    'aggregate_observed_time': aggregates, 'per_model_medians': cases,\n    'source_sha256': {str(path): sha(path) for path in sources},\n    'driver_source': Path(__file__).read_text(encoding='utf-8'), 'driver_sha256': sha(__file__),\n    'interpretation': [\n        '聚合按实际观察到的纳秒加权，大输入贡献更大；这不是每模型等权，也不是公开成绩。成功子集仅用于诊断，失败仍在all_on及85条原件。',\n        'exclusive逐条和聚合守恒，inclusive含嵌套不可相加；各stage分别取中位数不承诺相加仍守恒。',\n        'total不是进程wall，不含MPS解析、Report初始化/输出；开启profile自身扰动时间，不能据此宣称优化加速。',\n        'AAt C API阶段包含库内部矩形乘积形成与分解，不等于纯Cholesky；normal_solve exclusive包含消元/恢复、分配、检查等，不能全部当稀疏矩阵遍历。',\n        '本轮来自生产v66，不包含v81预算批量与v80基恢复；不将此占比直接当叠加优化后的比例。']}\nwith OUTPUT.open('x', encoding='utf-8') as stream:\n    json.dump(result, stream, ensure_ascii=False, indent=2, allow_nan=False)\n    stream.write('\\n')\nprint(json.dumps({'passed': True, 'new_solver_runs': 0,\n    'aggregate_top': {name: {'profiles': value['profiles'], 'total_ns': value['total_inclusive_ns'],\n        'top': value['stages_by_exclusive'][:5]} for name, value in aggregates.items()}}, ensure_ascii=False))\n",
