  "source": "\"\"\"归档第64轮独立采集与离线分析原件，并逐成员回读校验。\"\"\"\nimport datetime\nimport hashlib\nimport json\nfrom pathlib import Path\nimport zipfile\n\nROOT = Path(__file__).resolve().parents[1]\nDATA = ROOT / 'knowledge/experiments/data/2026-10-12-halpern-ipm'\ntarget = DATA / 'v67-diagnostic-artifacts.zip'\nmanifest = DATA / 'v67-archive-manifest.json'\nassert not target.exists() and not manifest.exists()\nanalysis = json.loads((DATA / 'v67-analysis.json').read_text(encoding='utf-8'))\nassert analysis['completed'] is True\nbuild = ROOT / '.tools/v67-diagnostic'\noracle = ROOT / '.tools/v67-offline-oracles'\nfiles = sorted(set(p for p in build.iterdir() if p.is_file() and p.suffix in ('.json', '.bin', '.cpp', '.txt', '.d')) |\n               set(p for p in (build / 'captures').iterdir() if p.is_file()) |\n               set(p for p in oracle.rglob('*') if p.is_file()))\nmembers = {}\nwith zipfile.ZipFile(target, 'x', compression=zipfile.ZIP_DEFLATED, compresslevel=6) as z:\n    for path in files:\n        assert path.resolve().is_relative_to(ROOT)\n        name = path.relative_to(ROOT).as_posix()\n        content = path.read_bytes()\n        members[name] = {'sha256': hashlib.sha256(content).hexdigest(), 'bytes': len(content)}\n        z.writestr(name, content)\nwith zipfile.ZipFile(target) as z:\n    assert set(z.namelist()) == set(members) and len(z.namelist()) == len(members)\n    for name, identity in members.items():\n        content = z.read(name)\n        assert hashlib.sha256(content).hexdigest() == identity['sha256'] and len(content) == identity['bytes']\nsource = Path(__file__).read_bytes()\nrecord = {'passed': True, 'created_at_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),\n          'archive': target.name, 'archive_sha256': hashlib.sha256(target.read_bytes()).hexdigest(),\n          'archive_bytes': target.stat().st_size, 'members': members,\n          'source': source.decode('utf-8'), 'source_sha256': hashlib.sha256(source).hexdigest(),\n          'excludes': ['独立exe及obj；其身份和命令由build-manifest记录', 'v66冻结来源包已单独存在'],\n          'solver_runs': 0}\nwith manifest.open('x', encoding='utf-8') as f:\n    json.dump(record, f, ensure_ascii=False, indent=2)\n    f.write('\\n')\nprint(json.dumps({'passed': True, 'members': len(members), 'archive_bytes': record['archive_bytes'], 'solver_runs': 0}))\n",
