  "script_source": "\"\"\"事后固定已有 a0 检查三种候选组装；不搜索系数、不调用 LP 或修改生产。\"\"\"\n\nimport hashlib\nimport importlib.util\nimport json\nfrom fractions import Fraction\nfrom pathlib import Path\nimport struct\nimport sys\nimport time\n\n\nROOT = Path(__file__).resolve().parents[1]\nDATA = ROOT / \"knowledge/experiments/data/2026-10-12-halpern-ipm\"\nHELPER = DATA / \"v67-analyze.py\"\nHELPER_SHA = \"e79200011b53a3d982681365b5134a546223515837e0ece870de4cb860e14322\"\nANALYSIS = DATA / \"v67-analysis.json\"\nANALYSIS_SHA = \"6b709f26d36184003b8fcb2db80cdf7e83f4d2307c7592bed90165982658cb3f\"\nOUTPUT = DATA / \"v67-assembly-probe.json\"\n\n\ndef digest(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\nif digest(HELPER) != HELPER_SHA:\n    raise ValueError(\"冻结 v67 分析辅助来源改变\")\nspec = importlib.util.spec_from_file_location(\"v67_assembly_helpers\", HELPER)\nA = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(A)\n\n\ndef accumulated(base, z, coefficients, wide_format, product_format):\n    \"\"\"按实际 j 顺序在指定宽格式累加，保留到最后一次 binary64 写回。\"\"\"\n    values = [Fraction.from_float(x) for x in base]\n    negative_zeros = [x == 0 and A.negative(x) for x in base]\n    dimension = len(base)\n    for j, coefficient in enumerate(coefficients):\n        exact_coefficient = Fraction.from_float(coefficient)\n        for i in range(dimension):\n            direction = z[j * dimension + i]\n            product = A.rounded_binary(exact_coefficient * Fraction.from_float(direction), *product_format)\n            product_negative_zero = not product and A.negative(coefficient) != A.negative(direction)\n            total = values[i] + product\n            negative_zero = not total and not values[i] and not product and negative_zeros[i] and product_negative_zero\n            values[i] = A.rounded_binary(total, *wide_format)\n            negative_zeros[i] = not values[i] and (total < 0 or negative_zero)\n    return values, [A.cast64(value, negative_zero=sign) for value, sign in zip(values, negative_zeros)]\n\n\ndef self_test():\n    wide = (64, -16381, 16384)\n    narrow = (53, -1021, 1024)\n    checks = 0\n\n    def check(value):\n        nonlocal checks\n        A.require(value, \"候选组装纯合成自检失败\")\n        checks += 1\n\n    base, z, coefficients = [2.0 ** 53], [1.0, -(2.0 ** 53)], [1.0, 1.0]\n    check(accumulated(base, z, coefficients, wide, wide)[1] == [1.0])\n    check(accumulated(base, z, coefficients, wide, narrow)[1] == [1.0])\n    check(A.production_combination(base, z, coefficients, wide) == [0.0])\n    base, z, coefficients = [-1.0], [1.0 - 2.0 ** -27], [1.0 + 2.0 ** -27]\n    check(accumulated(base, z, coefficients, wide, wide)[1] == [-2.0 ** -54])\n    check(accumulated(base, z, coefficients, wide, narrow)[1] == [0.0])\n    increment = float(A.power2(-53) + A.power2(-65))\n    check(accumulated([1.0], [1.0], [increment], wide, wide)[1] == [1.0])\n    check(A.cast64(Fraction(1) + Fraction.from_float(increment)) == 1.0 + 2.0 ** -52)\n    check(A.negative(accumulated([-0.0], [1.0], [-0.0], wide, narrow)[1][0]))\n    return {\"passed\": True, \"checks\": checks, \"oracle_runs\": 0, \"original_lp_runs\": 0}\n\n\ndef inspect_point(data, name, formula, before, point, production, construction_seconds):\n    started = time.perf_counter()\n    exact_point = [Fraction.from_float(x) for x in point]\n    final_residual = A.exact_residual(data, exact_point)\n    before_residual = A.exact_residual(data, before)\n    return {\"name\": name, \"arithmetic\": formula, \"assembly_seconds\": construction_seconds,\n        \"before_final_binary64\": A.residual_summary(data, before_residual),\n        \"after_final_binary64\": A.residual_summary(data, final_residual),\n        \"final_rounding_error\": A.BASE.vector_summary([x - y for x, y in zip(exact_point, before)]),\n        \"point_sha256\": hashlib.sha256(b\"\".join(struct.pack(\"<d\", x) for x in point)).hexdigest(),\n        \"bitwise_different_from_production_coordinates\": sum(struct.pack(\"<d\", x) != struct.pack(\"<d\", y)\n                                                              for x, y in zip(point, production)),\n        \"exact_residual_verification_seconds\": time.perf_counter() - started}\n\n\ndef main():\n    A.require(len(sys.argv) == 1, \"本次事后探针不接受额外输入或搜索参数\")\n    A.require(not OUTPUT.exists(), \"不覆盖已保存的补充证据\")\n    started, started_at = time.perf_counter(), A.utc()\n    A.require(digest(ANALYSIS) == ANALYSIS_SHA, \"冻结分析结果改变\")\n    analysis = A.read_json(ANALYSIS)\n    A.require(analysis.get(\"completed\") is True and len(analysis[\"analyses\"]) == 1,\n              \"本次只处理已有唯一数值捕获\")\n    reference = analysis[\"analyses\"][0]\n    A.require(reference[\"production_replay\"][\"bitwise_equal\"] is True,\n              \"原生产逐项重放尚未逐位通过\")\n    identity, metadata, data = A.load_snapshot(reference[\"capture\"][\"metadata\"])\n    A.require(identity == reference[\"capture\"] and data[\"numerical_sha256\"] == reference[\"numerical_sha256\"],\n              \"捕获身份改变\")\n    a = data[\"arrays\"]\n    source = Path(__file__).read_bytes()\n    result = {\"schema\": \"v67_assembly_probe_1\", \"posthoc\": True, \"started_at_utc\": started_at,\n        \"script_path\": str(Path(__file__).resolve()), \"script_sha256\": hashlib.sha256(source).hexdigest(),\n        \"script_source\": source.decode(\"utf-8\"), \"helper_sha256\": HELPER_SHA,\n        \"analysis_path\": str(ANALYSIS), \"analysis_sha256\": ANALYSIS_SHA, \"capture\": identity,\n        \"numerical_sha256\": data[\"numerical_sha256\"], \"event\": reference[\"event\"],\n        \"dimension\": data[\"dimension\"], \"coefficient_count\": data[\"cc\"], \"wide_format\": list(data[\"wide_format\"]),\n        \"self_test\": self_test(), \"oracle_runs\": 0, \"original_lp_runs\": 0, \"coefficient_searches\": 0,\n        \"production_evidence_reused\": {\"replay\": reference[\"production_replay\"],\n            \"exact_residual\": reference[\"baseline\"][\"production_candidate_exact\"],\n            \"exact_continuous\": reference[\"baseline\"][\"exact_continuous\"]}, \"points\": [],\n        \"historical_evidence\": [\n            {\"path\": str(DATA / \"v42-newton-analysis.json\"),\n             \"sha256\": \"26a5545e13e3d981da764b3770cf9cb1a23cc09e2d92422683225dace92884bf\",\n             \"scope\": \"旧完整Newton固定候选已观测LD累加通过而回double失败；不与当前普通常数状态混同。\"},\n            {\"path\": str(DATA / \"v59-representability.json\"),\n             \"sha256\": \"c904a8a32c8bde1dda1916b002ca8183eeeb3d44619bd2dfccceadf79b00d422\",\n             \"scope\": \"旧terminal固定x时两消元行最优binary64 z仍超限；不是本次可变全向量的不可表示证明。\"}],\n        \"limits\": [\"正式分析完成后追加，仅解释已有a0，不回改事前计划或重跑oracle。\",\n                   \"三种组装均保留原base/Z/a0及j顺序；不搜索系数、邻接格点或其他舍入方向。\",\n                   \"宽乘法与宽加法分开最近偶数舍入，不使用融合乘加；最后统一round53。\",\n                   \"精确残差达标不证明生产浮点残差检查、HSD方向或原LP接受。\",\n                   \"某一种最近舍入点失败不证明所有binary64点或当前空间均不可行。\",\n                   \"全部额外组装和原K0精确扫描是离线成本，不计作公开LP性能改善。\"]}\n    try:\n        point_start = time.perf_counter()\n        exact = A.continuous_combination(a[\"base\"], a[\"z\"], [Fraction.from_float(x) for x in a[\"coefficients\"]])\n        point = [A.cast64(x) for x in exact]\n        result[\"points\"].append(inspect_point(data, \"exact_sum_round53_once\", \"精确base+Za0，最后每坐标round53一次\",\n            exact, point, a[\"last_candidate\"], time.perf_counter() - point_start))\n        for name, product_format, formula in (\n            (\"wide_products_wide_sum_round53_once\", data[\"wide_format\"], \"每项宽乘积舍入，逐j宽加法舍入，最后round53一次\"),\n            (\"double_products_wide_sum_round53_once\", (53, -1021, 1024), \"每项double乘积舍入，逐j宽加法舍入，最后round53一次\")):\n            point_start = time.perf_counter()\n            before, point = accumulated(a[\"base\"], a[\"z\"], a[\"coefficients\"], data[\"wide_format\"], product_format)\n            result[\"points\"].append(inspect_point(data, name, formula, before, point, a[\"last_candidate\"], time.perf_counter() - point_start))\n        result[\"completed\"] = True\n    except Exception as failure:\n        result.update(completed=False, error_type=type(failure).__name__, error=str(failure))\n        raise\n    finally:\n        result.update(completed_at_utc=A.utc(), elapsed_wall_seconds=time.perf_counter() - started)\n        A.write_json(OUTPUT, result)\n    print(json.dumps({\"completed\": result[\"completed\"], \"self_test\": result[\"self_test\"], \"oracle_runs\": 0,\n        \"points\": [{\"name\": p[\"name\"], \"ratio\": p[\"after_final_binary64\"][\"maximum_normalized_residual\"][\"decimal80\"],\n                    \"satisfies_original_tolerances\": p[\"after_final_binary64\"][\"satisfies_original_tolerances\"]}\n                   for p in result[\"points\"]], \"output_sha256\": digest(OUTPUT)}, ensure_ascii=False))\n\n\nif __name__ == \"__main__\":\n    main()\n",
